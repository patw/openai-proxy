# Server settings
# The port the proxy + web UI will run on
PROXY_PORT=8086
# The IP address to bind to. Defaults to 127.0.0.1 (localhost only) — nothing
# off this machine can reach it. Set your LAN IP to reach it from other devices,
# or 0.0.0.0 for all interfaces (set PROXY_API_KEY too if you do).
BIND_HOST=127.0.0.1
# How many requests the proxy will handle at once. Each in-flight request
# holds one thread for the whole upstream call, so this caps concurrency.
# The threads are blocked on the network, not the CPU — raising this is cheap.
PROXY_THREADS=32
# Optional shared key for the proxy API. Leave blank for open localhost use.
# When set, every /v1/* request must send: Authorization: Bearer <this key>
PROXY_API_KEY=
# Flask secret key for session cookies (change this to something random)
FLASK_SECRET_KEY=change-me-to-something-random
